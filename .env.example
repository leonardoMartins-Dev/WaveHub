# =========================================================
# ARQUIVO DE EXEMPLO
# Copie para ".env" (na raiz do projeto) e troque os valores:
#   cp .env.example .env
# O ".env" está no .gitignore e não vai para o GitHub.
# =========================================================

# =========================================================
# SUPABASE (PostgreSQL)
# Supabase > Connect > Type: JDBC > Method: Session pooler
# =========================================================
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# =========================================================
# GMAIL (envio do e-mail de recuperação de senha)
# Use uma senha de app, não a senha normal da conta:
# https://myaccount.google.com/apppasswords
# =========================================================
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app

# =========================================================
# GOOGLE reCAPTCHA v2 ("Não sou um robô")
# https://www.google.com/recaptcha/admin
# Inclua "localhost" na lista de domínios da chave.
# =========================================================
RECAPTCHA_SITE_KEY=sua-site-key
RECAPTCHA_SECRET_KEY=sua-secret-key

# =========================================================
# WEATHERAPI (clima do lugar)
# https://www.weatherapi.com/signup.aspx
# =========================================================
apiKey=sua-chave-da-weatherapi

# =========================================================
# OPCIONAL
# Endereço público do site, usado no link do e-mail de
# recuperação de senha. Sem ele, usa http://localhost:8080
# =========================================================
# APP_BASE_URL=https://seu-dominio.com
